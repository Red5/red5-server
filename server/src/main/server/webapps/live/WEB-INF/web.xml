<?xml version="1.0" encoding="ISO-8859-1"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <display-name>live</display-name>
    <context-param>
        <param-name>webAppRootKey</param-name>
        <param-value>/live</param-value>
    </context-param>
    <!-- WebSocket Origin checking, off unless enabled here or on the WebSocket plugin. When enabled, handshakes without an Origin
         header or from an origin not listed are rejected. Entries are comma-separated; one with a scheme must match scheme, host
         and port exactly, one without a scheme (example.com or example.com:5080) matches that host, and port if given, under any
         scheme, and * allows any origin. Enable it if the application relies on HTTP sessions, cookies or container login.
    <context-param>
        <param-name>crossOriginPolicy</param-name>
        <param-value>true</param-value>
    </context-param>
    <context-param>
        <param-name>allowedOrigins</param-name>
        <param-value>https://example.com,http://localhost:5080</param-value>
    </context-param>
    -->
    <!-- Server-Sent Events Servlet -->
